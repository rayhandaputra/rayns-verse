# ==============================================================================
# KINAU CLIENT - ENVIRONMENT VARIABLES
# ==============================================================================
# Anda dapat meng-copy semua baris di bawah ini dan paste langsung ke:
# Vercel Project Settings -> Environment Variables (Key-Value)
# ==============================================================================

# [1] SESSION & AUTHENTICATION
# Kunci enkripsi untuk session cookie pengguna
SESSION_SECRET="kinau_secure_session_secret_default_2026_key"

# [2] API & BACKEND SECRETS
# Secret token untuk otorisasi server-to-server request ke Super API apicore
INTERNAL_API_SECRET="REPLACE_WITH_STRONG_KEY"

# Token khusus untuk autentikasi endpoint AI Agent Bridge (raw SQL, schema, bridge)
AGENT_KEY="REPLACE_WITH_AGENT_KEY"

# [3] AI & LLM PROVIDER
# Google Gemini AI API Key (digunakan oleh AI self-healing & agent query)
GEMINI_API_KEY=""

# [4] APPLICATION URL & ENVIRONMENT
VITE_NODE_ENV="production"
APP_URL="https://kinau.id"

